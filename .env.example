# Drizzle
# For local development, use a local PostgreSQL instance.
# Lightsail production uses a Compose database and sets this in /etc/auditlift/app.env.
DATABASE_URL="postgres://user:password@host:port/db-name"
# Local PostgreSQL generally does not use TLS. Set true or omit for managed databases that do.
DATABASE_SSL="false"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
# Must match the public domain (e.g., https://auditlift.app)
BETTER_AUTH_URL=""

# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth
# https://www.better-auth.com/docs/authentication/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenRouter (for AI policy generation)
OPEN_ROUTER_API_KEY=""

# AWS S3 Storage
# In production, leave BUCKET_ENDPOINT empty to use the workload's AWS credentials.
# In dev, set BUCKET_ENDPOINT to an S3-compatible service (e.g., MinIO, Cloudflare R2).
BUCKET_ENDPOINT=""
BUCKET_REGION="us-east-1"
# BUCKET_NAME is the primary name used by the code.
# S3_BUCKET_NAME is a compatibility fallback.
BUCKET_NAME=""
S3_BUCKET_NAME=""
# Only needed for S3-compatible mode (dev). Not used in AWS production (IAM instance profile).
BUCKET_ACCESS_KEY=""
BUCKET_SECRET_KEY=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price IDs for subscription plans
STRIPE_STARTER_MONTHLY_PRICE_ID=""
STRIPE_STARTER_YEARLY_PRICE_ID=""
STRIPE_GROWTH_MONTHLY_PRICE_ID=""
STRIPE_GROWTH_YEARLY_PRICE_ID=""

# Resend (transactional email)
RESEND_API_KEY=""

# Advisory team email for consulting/vCISO request notifications
ADVISORY_TEAM_EMAIL=""

# Optional: Better Auth API key for server-to-server calls
BETTER_AUTH_API_KEY=""

# PostHog Analytics
PUBLIC_POSTHOG_KEY=""
PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
