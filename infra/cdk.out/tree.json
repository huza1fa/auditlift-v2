th":"AuditLiftInfraStack/AuditLiftEc2/Resource","constructInfo":{"fqn":"aws-cdk-lib.aws_ec2.CfnInstance","version":"2.254.0"},"attributes":{"aws:cdk:cloudformation:type":"AWS::EC2::Instance","aws:cdk:cloudformation:logicalId":"AuditLiftEc22AE5417B","aws:cdk:cloudformation:props":{"availabilityZone":"us-west-2a","iamInstanceProfile":{"Ref":"AuditLiftEc2InstanceProfile77BCDB91"},"imageId":{"Ref":"SsmParameterValueawsservicecanonicalubuntuserver2204stablecurrentamd64hvmebsgp2amiidC96584B6F00A464EAD1953AFF4B05118Parameter"},"instanceType":"m7i-flex.large","keyName":{"Ref":"KeyName"},"securityGroupIds":[{"Fn::GetAtt":["Ec2SecurityGroup55889913","GroupId"]}],"subnetId":{"Ref":"AuditLiftVpcpublicSubnet1Subnet83EED146"},"tags":[{"key":"Name","value":"AuditLiftInfraStack/AuditLiftEc2"}],"userData":{"Fn::Base64":"#!/bin/bash\n#!/bin/bash\nset -e\nexec > >(tee /var/log/user-data.log|logger -t user-data -s 2>/dev/console) 2>&1\nrm -rf /opt/auditlift\n\n# ── System deps ─────────────────────────────────────────────\napt-get update -qq\napt-get install -y -qq nginx jq git curl unzip python3 build-essential ca-certificates gnupg\n\n# ── Bun ─────────────────────────────────────────────────────\nexport HOME=/root\ncurl -fsSL https://bun.sh/install | bash\ncp /root/.bun/bin/bun /usr/local/bin/bun\ncp /root/.bun/bin/bunx /usr/local/bin/bunx\n\n# ── PM2 ─────────────────────────────────────────────────────\nbun install -g pm2\n\n# ── Create swap (8GB — m7i-flex.large has 8GB RAM, swap helps with builds)\nfallocate -l 4G /swapfile\nchmod 600 /swapfile\nmkswap /swapfile\nswapon /swapfile\necho \"/swapfile none swap sw 0 0\" >> /etc/fstab\n\n# ── App directory ────────────────────────────────────────────\nmkdir -p /opt/auditlift\n\n# ── Fetch secrets → .env ──────────────────────────────────────\npython3 -c \"\nimport subprocess, json\nr = subprocess.run([\"aws\", \"secretsmanager\", \"get-secret-value\", \"--secret-id\", \"auditlift-prod-env\", \"--region\", \"us-west-2\", \"--output\", \"text\", \"--query\", \"SecretString\"], capture_output=True, text=True)\nd = json.loads(r.stdout.strip())\nwith open(\"/opt/auditlift/.env\", \"w\") as f:\n    for k, v in d.items():\n        f.write(f\"{k}={v}\\n\")\n\"\n\n# ── Clone repo ───────────────────────────────────────────────\nexport GITHUB_TOKEN=$(grep ^GITHUB_TOKEN /opt/auditlift/.env | head -1 | cut -d= -f2-)\ncd /opt/auditlift\ngit clone https://${GITHUB_TOKEN}@github.com/huza1fa/auditlift-v2.git tmp\nshopt -s dotglob\nmv tmp/* . 2>/dev/null || true\nrm -rf tmp\n\n# ── Install & build ──────────────────────────────────────────\nbun install --frozen-lockfile\nbun run build\n\n# ── Run DB migrations ────────────────────────────────────────\ncd /opt/auditlift\nbun run db:push 2>&1 || echo \"Migration had issues (non-fatal, continuing)\"\n\n# ── Start app ────────────────────────────────────────────────\ncd /opt/auditlift && pm2 start /usr/local/bin/bun --name auditlift -- build/index.js\npm2 startup systemd -u root --hp /root\npm2 save\n\n# ── Nginx reverse proxy ──────────────────────────────────────\ncat > /etc/nginx/sites-available/default << 'NGINX'\nserver {\n    listen 80;\n    server_name _;\n\n    client_max_body_size 10m;\n\n    location / {\n        proxy_pass http://127.0.0.1:3000;\n        proxy_http_version 1.1;\n        proxy_set_header Upgrade $http_upgrade;\n        proxy_set_header Connection \"upgrade\";\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n        proxy_set_header X-Forwarded-Proto $scheme;\n        proxy_cache_bypass $http_upgrade;\n    }\n}\nNGINX\nsystemctl restart nginx\nsystemctl enable nginx\n\necho \"✅ User data script complete\""}}}}}},"SsmParameterValue:--aws--service--canonical--ubuntu--server--22.04--stable--current--amd64--hvm--ebs-gp2--ami-id:C96584B6-F00A-464E-AD19-53AFF4B05118.Parameter":{"id":"SsmParameterValue:--aws--service--canonical--ubuntu--s